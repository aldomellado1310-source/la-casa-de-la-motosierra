rules_version = '2';

// Reglas de Storage — fotos de producto, comprobantes y PDFs
service firebase.storage {
  match /b/{bucket}/o {

    /** true si quien llama tiene rol admin en Firestore */
    function esAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Fotos de producto: lectura pública, escritura SOLO admin
    // (validado contra el rol en Firestore, no solo en el panel)
    match /productos/{productoId}/{archivo} {
      allow read: if true;
      allow write: if esAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Comprobantes de transferencia: sube cualquiera con el número-token
    // del pedido (invitados incluidos), pero solo imagen o PDF.
    // Lectura SOLO admin: contienen datos bancarios personales de clientes.
    match /comprobantes/{pedidoId}/{archivo} {
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow read: if esAdmin();
    }

    // PDFs de cotización: los genera la Cloud Function (Admin SDK);
    // se leen mediante URL firmada
    match /cotizaciones/{archivo} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
