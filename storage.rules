rules_version = '2';

// Reglas de Storage — fotos de producto, comprobantes y PDFs
service firebase.storage {
  match /b/{bucket}/o {

    /** true si quien llama tiene rol admin en Firestore */
    function esAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Fotos de producto: lectura pública, escritura SOLO admin
    // (validado contra el rol en Firestore, no solo en el panel)
    match /productos/{productoId}/{archivo} {
      allow read: if true;
      allow write: if esAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Comprobantes de transferencia: sube cualquiera con el número-token
    // del pedido (invitados incluidos), pero SOLO mientras el pedido existe
    // y está 'pendiente_pago' (CN-008: evita subidas anónimas ilimitadas).
    // El frontend sube el archivo ANTES de pasar el pedido a
    // 'pendiente_validacion' (services/pedidos.ts → subirComprobante).
    // Solo create: no se sobrescriben ni borran comprobantes ya subidos.
    // Lectura SOLO admin: contienen datos bancarios personales de clientes.
    match /comprobantes/{pedidoId}/{archivo} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)|application/pdf')
        && firestore.exists(/databases/(default)/documents/pedidos/$(pedidoId))
        && firestore.get(/databases/(default)/documents/pedidos/$(pedidoId)).data.estado == 'pendiente_pago';
      allow read: if esAdmin();
    }

    // PDFs de cotización: los genera la Cloud Function (Admin SDK) y se
    // entregan por URL firmada, que no pasa por estas reglas. Lectura con
    // el SDK cliente SOLO admin (CN-009: los folios COT-AAAA-NNNN son
    // correlativos y cualquier usuario autenticado podía enumerarlos).
    match /cotizaciones/{archivo} {
      allow read: if esAdmin();
      allow write: if false;
    }
  }
}
