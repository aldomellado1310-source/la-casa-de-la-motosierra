# Parámetros NO secretos de las Cloud Functions (se versiona).
# Los secretos (claves de Webpay, Mercado Pago y Flow) van con:
#   firebase functions:secrets:set NOMBRE
#
# Orígenes del frontend aceptados (CORS y retorno de pagos). El PRIMERO
# es el de respaldo. Al tener el dominio definitivo, agrégalo AL INICIO
# (con y sin www) y vuelve a desplegar las functions.
ORIGENES_PERMITIDOS=https://la-casa-de-la-motosierra.web.app,https://la-casa-de-la-motosierra.firebaseapp.com,http://localhost:5173,http://localhost:4173

# Flow: 'true' = sandbox.flow.cl (pruebas). Cambiar a 'false' con las
# credenciales de producción del cliente.
FLOW_SANDBOX=true
