    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "mercadopago": "^3.6.1",
    "pdfkit": "^0.15.1",
    "transbank-sdk": "^5.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.5",
    "typescript": "^5.6.3"
  },
  "private": true
}
