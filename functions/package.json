{
  "name": "functions",
  "description": "Cloud Functions — pagos (Webpay/Mercado Pago) y PDF de cotizaciones",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "cd .. && npx tsx --test functions/src/*.test.ts",
