  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "mercadopago": "^2.0.15",
    "pdfkit": "^0.15.1",
    "transbank-sdk": "^5.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.5",
    "typescript": "^5.6.3"
  },
  "private": true
}
