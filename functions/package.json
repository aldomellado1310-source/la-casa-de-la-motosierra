{
  "name": "functions",
  "description": "Cloud Functions — pagos (Webpay/Mercado Pago/Flow) y PDF de cotizaciones",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
