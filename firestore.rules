rules_version = '2';

// Reglas de seguridad Firestore — La Casa de la Motosierra
service cloud.firestore {
  match /databases/{database}/documents {

    /** true si el usuario autenticado tiene rol admin */
    function esAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Catálogo: lectura pública, escritura solo admin
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /categorias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Perfiles: cada usuario ve/edita el suyo; admin ve todos.
    // El rol no puede ser cambiado por el propio usuario.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && (!('rol' in request.resource.data) || request.resource.data.rol == 'cliente');
      allow update: if (request.auth != null && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol) || esAdmin();
    }

    // Carritos: solo el dueño
    match /carritos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pedidos: crea cualquiera (incluye invitados vía frontend), pero con
    // forma mínima y SIEMPRE en estado inicial 'pendiente_pago' — un pedido
    // no puede nacer "pagado": ese estado lo fijan las Cloud Functions
    // (Admin SDK) tras verificar el pago, o el admin.
    // `get` por id es público para el seguimiento de pedido sin sesión:
    // el número de pedido (sufijo criptográfico de 8 caracteres) actúa
    // como token de consulta. `list` (enumerar) queda solo para el admin.
    match /pedidos/{id} {
      allow create: if request.resource.data.estado == 'pendiente_pago'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.emailCliente is string;
      allow get: if true;
      // Cada usuario puede listar solo sus pedidos (query con uid == auth.uid)
      allow list: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // Adjuntar comprobante de transferencia: cualquiera con el número-token
      // (cubre pedidos de invitado, sin sesión). Solo permite la transición
      // pendiente_pago → pendiente_validacion; jamás auto-marcarse 'pagado'.
      allow update: if esAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['comprobanteUrl', 'estado'])
            && resource.data.estado == 'pendiente_pago'
            && request.resource.data.estado == 'pendiente_validacion'
            && request.resource.data.comprobanteUrl is string);
      allow delete: if esAdmin();
    }

    // Cotizaciones: crea el usuario autenticado, lee dueño/admin,
    // estado lo gestiona el admin
    match /cotizaciones/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Avisos "cuando llegue stock": cualquiera puede dejar su correo
    match /avisosStock/{id} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    // Contadores correlativos (folio de cotización por año).
    // Solo usuarios autenticados: las cotizaciones exigen sesión.
    match /contadores/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
