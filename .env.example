# ============================================================
# La Casa de la Motosierra — Variables de entorno (frontend)
# Copiar a .env y completar con las credenciales reales.
# Sin estas variables la app corre en MODO DEMO con datos locales.
# ============================================================

# --- Firebase (consola > Configuración del proyecto > Tus apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- URL base de las Cloud Functions (pagos) ---
VITE_FUNCTIONS_URL=

# --- WhatsApp de la tienda (formato internacional sin +) ---
VITE_WHATSAPP_NUMERO=56912345678
